{
  "name": "tiletown",
  "private": true,
  "description": "City builder cosy en tuiles, 3D basse définition au rendu lisse (three.js), d'abord sur téléphone. esbuild construit dist/ ; les outils importent les kits 3D libres.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "check": "node tools/build.js --check",
    "test": "node --test tests/",
    "fetch-kits": "node tools/fetch-kits.js",
    "import-models": "node tools/import-models.js",
    "measure": "node tools/measure.mjs",
    "preview-models": "node tools/preview-models.mjs",
    "make-icons": "node tools/make-icons.mjs",
    "print-world": "node tools/print-world.js",
    "review:mobile": "node tools/review-mobile.mjs",
    "review:layers": "node tools/review-layers.mjs",
    "render-previews": "node tools/render-previews.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "adm-zip": "^0.5.16",
    "esbuild": "0.28.2",
    "meshoptimizer": "^0.25.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0"
  }
}
